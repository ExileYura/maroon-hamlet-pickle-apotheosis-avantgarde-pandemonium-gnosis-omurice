{
  "Forza Build Table": {
    "scope": "markdown",
    "prefix": "buildtable",
    "body": [
      "<table>",
      "<tr>",
      "<th>Setting</th>",
      "<th>Front</th>",
      "<th>Rear</th>",
      "</tr>",
      "<tr>",
      "<td>${1:Camber}</td>",
      "<td>${2:-2.0}</td>",
      "<td>${3:-1.5}</td>",
      "</tr>",
      "<tr>",
      "<td colspan=\"3\">${4:Comment}</td>",
      "</tr>",
      "</table>",
      "$0"
    ]
  }
}